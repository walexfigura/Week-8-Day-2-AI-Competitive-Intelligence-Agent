# Copy this file to .env and fill in your key:  cp .env.example .env
# Never commit .env (it is git-ignored).

# Required for `demo`, `briefing` (without --offline), and agent evaluations.
OPENAI_API_KEY=

# Model used by the agent. Any current OpenAI model that supports the Responses API
# and function calling should work. Default: gpt-5.4-mini
OPENAI_MODEL=gpt-5.4-mini

# Optional: reasoning effort for reasoning models (e.g. low, medium, high). Leave blank for the model default.
OPENAI_REASONING_EFFORT=

# Review annotation: "llm" (the agent's model labels reviews with Structured Outputs)
# or "reference" (hand-labeled annotations shipped with the fictional data; no API call).
CI_SENTIMENT_SOURCE=llm
# Optional: a different model just for review annotation.
CI_SENTIMENT_MODEL=

# Run limits — the agent cannot call tools forever.
CI_MAX_ITERATIONS=16
CI_MAX_TOOL_CALLS=40

# "Today" in the fictional dataset (keeps runs reproducible).
CI_REFERENCE_DATE=2026-11-14

# Data mode: "mock" (default, fictional local fixtures) or "live" (pages you list in live-sources.json).
CI_DATA_MODE=mock
CI_LIVE_SOURCES_FILE=live-sources.json
CI_LIVE_MIN_INTERVAL_SECONDS=10
CI_LIVE_TIMEOUT_SECONDS=15

# Optional: folder with review exports you are permitted to use (<PRODUCT_ID>.json or .csv).
CI_REVIEW_EXPORT_DIR=
